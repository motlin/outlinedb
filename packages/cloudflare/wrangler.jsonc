{
	"name": "outlinedb",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"limits": {"cpu_ms": 300000},
	// Served only on the custom domain; workers.dev and preview URLs are off.
	"routes": [{"pattern": "app.outlinedb.com", "custom_domain": true}],
	"workers_dev": false,
	"preview_urls": false,
	// Workers Logs, unsampled, so every exception, Durable Object reset and out-of-memory crash is kept (head sampling
	// drops whole invocations, errors included). Week of 2026-11-16: ~1.3k Worker requests + ~16k Durable Object
	// invocations, about 75k log events a month, under 0.5% of the 20M Workers Paid includes ($0.60 per million after).
	// Lower head_sampling_rate only if that nears 20M. Traces stay off: each span is a billed event too.
	"observability":
	{
		"logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": true},
		"traces": {"enabled": false},
	},
	"assets":
	{
		"directory": "../web/dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/health", "/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"],
	},
	"durable_objects":
	{
		"bindings": [{"name": "USER_STORE", "class_name": "UserStore"}],
	},
	// OAuth clients, grants and hashed tokens for the MCP connector; deploy provisions the namespace when it has no id.
	"kv_namespaces": [{"binding": "OAUTH_KV"}],
	// Better Auth users, sessions and verification tokens. CI applies migrations/ remotely before each deploy.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "outlinedb-auth",
			"database_id": "754f5300-f773-489b-8ca1-89dd8d6077f3",
			"migrations_dir": "migrations",
		},
	],
	// FILES holds attachment bytes, under each user's Durable Object id; create the bucket before the first deploy with it.
	"r2_buckets": [
		{"binding": "SNAPSHOTS", "bucket_name": "outlinedb-snapshots"},
		{"binding": "FILES", "bucket_name": "outlinedb-files"},
	],
	// Related notes: Workers AI embeds with @cf/qwen/qwen3-embedding-0.6b (1024 dims), Vectorize stores and ranks the
	// vectors. Vectorize has no local simulator, so `wrangler dev` runs without it unless the binding gets "remote": true.
	"ai": {"binding": "AI"},
	// One data point per whole-tree workflowy.com download (blobs: cause, outcome; doubles: bytes, duration ms), which
	// scripts/cloudflare-usage-alert.mjs counts each day. The dataset is created on the first write.
	"analytics_engine_datasets": [{"binding": "TREE_DOWNLOADS", "dataset": "outlinedb_tree_downloads"}],
	"vectorize": [{"binding": "RELATED_INDEX", "index_name": "outlinedb-related"}],
	// Cloudflare Email Service sends Better Auth mail from EMAIL_FROM; no destination restriction so any user can be mailed
	// (Workers Paid). Deploys without the domain onboarded; only send() fails, with E_SENDER_DOMAIN_NOT_AVAILABLE.
	"send_email": [{"name": "EMAIL"}],
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["UserStore"]}],
	// OUTLINEDB_CREDENTIALS_KEY (seals each account's workflowy.com session) must not be a var: deploy would reset it. Set it as a secret; use .dev.vars locally (also DEV_IDENTITY).
	"vars":
	{
		"SYNC_INTERVAL_MINUTES": "60",
		"EMAIL_PROVIDER": "cloudflare",
		"EMAIL_FROM": "no-reply@outlinedb.com",
		// Better Auth's link origin and only trusted origin. /api/auth/* answers 503 until the BETTER_AUTH_SECRET secret is set.
		"APP_ORIGIN": "https://app.outlinedb.com",
		// closed, invite (emails in the SIGNUP_INVITES secret) or open.
		"SIGNUP_MODE": "open",
		// Public key of the OutlineDB Turnstile widget (app.outlinedb.com, managed); its secret is the TURNSTILE_SECRET_KEY secret.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF9lnLIbCzEVI1SE",
	},
}
