{
	"name": "outlinedb",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"limits": {"cpu_ms": 300000},
	// Served only on the custom domain behind Access; workers.dev and preview URLs are off so Access can't be bypassed.
	"routes": [{"pattern": "app.outlinedb.com", "custom_domain": true}],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../web/dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/health", "/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"],
	},
	"durable_objects": {
		"bindings": [{"name": "USER_STORE", "class_name": "UserStore"}],
	},
	// OAuth clients, grants and hashed tokens for the MCP connector; deploy provisions the namespace when it has no id.
	"kv_namespaces": [{"binding": "OAUTH_KV"}],
	// Better Auth users, sessions and verification tokens. CI applies migrations/ remotely before each deploy.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "outlinedb-auth",
			"database_id": "754f5300-f773-489b-8ca1-89dd8d6077f3",
			"migrations_dir": "migrations",
		},
	],
	"r2_buckets": [{"binding": "SNAPSHOTS", "bucket_name": "outlinedb-snapshots"}],
	// Related notes: Workers AI embeds with @cf/qwen/qwen3-embedding-0.6b (1024 dims), Vectorize stores and ranks the
	// vectors. Vectorize has no local simulator, so `wrangler dev` runs without it unless the binding gets "remote": true.
	"ai": {"binding": "AI"},
	"vectorize": [{"binding": "RELATED_INDEX", "index_name": "outlinedb-related"}],
	// Cloudflare Email Service sends Better Auth mail from EMAIL_FROM; no destination restriction so any user can be mailed
	// (Workers Paid). Deploys without the domain onboarded; only send() fails, with E_SENDER_DOMAIN_NOT_AVAILABLE.
	"send_email": [{"name": "EMAIL"}],
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["UserStore"]}],
	// Access config (ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAILS, ALLOWED_SERVICE_TOKENS) and OUTLINEDB_ENV_OWNERS must not be vars: deploy would reset them. Set them as secrets; use .dev.vars locally (also ACCESS_DEV_IDENTITY).
	"vars": {
		"SYNC_INTERVAL_MINUTES": "30",
		"EMAIL_PROVIDER": "cloudflare",
		"EMAIL_FROM": "no-reply@outlinedb.com",
		// Better Auth's link origin and only trusted origin. /api/auth/* answers 503 until the BETTER_AUTH_SECRET secret is set.
		"APP_ORIGIN": "https://app.outlinedb.com",
		// closed, invite (emails in the SIGNUP_INVITES secret) or open.
		"SIGNUP_MODE": "invite",
	},
}
