# Names only. Copy to .dev.vars and fill in locally; never commit values.
WORKFLOWY_API_KEY=
WORKFLOWY_USERNAME=
WORKFLOWY_PASSWORD=
WORKFLOWY_SESSION_COOKIE=
# WORKFLOWY_API_URL=
# ACCESS_DEV_IDENTITY=dev
# Better Auth: /api/auth/* answers 503 until this is set (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Comma-separated emails allowed to sign up when SIGNUP_MODE=invite.
SIGNUP_INVITES=
# Local dev serves on another origin than the committed var; set it to the dev server's origin, e.g. http://localhost:5173.
# APP_ORIGIN=
# SIGNUP_MODE=invite
# Turnstile: sign-up, sign-in and password reset answer 503 until both are set. Locally, uncomment these always-pass test keys.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
