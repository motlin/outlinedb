{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": [],
		"paths": {
			"@outlinedb/mcp/tools": ["../mcp/src/register.ts"],
			"@outlinedb/web/server-app": ["../web/src/server/app.ts"]
		}
	},
	"include": ["src/**/*", "test/**/*", "smoke/**/*", "worker-configuration.d.ts"]
}
