{
	"name": "@outlinedb/shared",
	"version": "0.0.0",
	"description": "Shared code between CLI and web packages",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./api": {
			"source": "./src/api/index.ts",
			"types": "./dist/api/index.d.ts",
			"import": "./dist/api/index.js"
		},
		"./calendar-lookup": {
			"source": "./src/cache/calendar-lookup.ts",
			"types": "./dist/cache/calendar-lookup.d.ts",
			"import": "./dist/cache/calendar-lookup.js"
		},
		"./internal": {
			"source": "./src/internal/index.ts",
			"types": "./dist/internal/index.d.ts",
			"import": "./dist/internal/index.js"
		},
		"./node": {
			"source": "./src/node/index.ts",
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js"
		},
		"./db": {
			"source": "./src/db/index.ts",
			"types": "./dist/db/index.d.ts",
			"import": "./dist/db/index.js"
		},
		"./schemas": {
			"source": "./src/schemas/index.ts",
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.js"
		},
		"./types": {
			"source": "./src/types/index.ts",
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./temporal": {
			"source": "./src/temporal/index.ts",
			"types": "./dist/temporal/index.d.ts",
			"import": "./dist/temporal/index.js"
		},
		"./html": {
			"source": "./src/html/index.ts",
			"types": "./dist/html/index.d.ts",
			"import": "./dist/html/index.js"
		},
		"./workflowy": {
			"source": "./src/workflowy/index.ts",
			"types": "./dist/workflowy/index.d.ts",
			"import": "./dist/workflowy/index.js"
		},
		"./cache": {
			"source": "./src/cache/index.ts",
			"types": "./dist/cache/index.d.ts",
			"import": "./dist/cache/index.js"
		},
		"./changes": {
			"source": "./src/changes/index.ts",
			"types": "./dist/changes/index.d.ts",
			"import": "./dist/changes/index.js"
		},
		"./utils": {
			"source": "./src/utils/index.ts",
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js"
		},
		"./search": {
			"source": "./src/search/index.ts",
			"types": "./dist/search/index.d.ts",
			"import": "./dist/search/index.js"
		},
		"./search-query": {
			"source": "./src/search/query-ast.ts",
			"types": "./dist/search/query-ast.d.ts",
			"import": "./dist/search/query-ast.js"
		},
		"./tags": {
			"source": "./src/tags/index.ts",
			"types": "./dist/tags/index.d.ts",
			"import": "./dist/tags/index.js"
		},
		"./db-migrations-bundle": {
			"source": "./src/db/migrations-bundle.generated.ts",
			"types": "./dist/db/migrations-bundle.generated.d.ts",
			"import": "./dist/db/migrations-bundle.generated.js"
		}
	},
	"scripts": {
		"build": "tsc && shx rm -rf dist/db/migrations && shx cp -r src/db/migrations dist/db/",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"chrono-node-v1": "npm:chrono-node@1.4.4",
		"dayjs": "^1.11.23",
		"drizzle-orm": "^0.45.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"shx": "^0.4.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20.11.0"
	}
}
