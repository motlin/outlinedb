{
	"name": "@workflowy/mcp",
	"version": "0.1.0",
	"description": "MCP server for Workflowy",
	"bin": {
		"outlinedb-mcp": "./bin/mcp.js"
	},
	"files": [
		"./bin",
		"./dist"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
