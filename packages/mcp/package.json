	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@workflowy/shared": "workspace:*",
		"@workflowy/web": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20.11.0"
	}
}
